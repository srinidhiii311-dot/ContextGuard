# ContextGuard Environment Configuration Template
# DO NOT commit .env containing production secrets to version control.
# Generate strong, random secrets using the commands below.

# ---------------------------------------------------------------------------
# Cryptographic Keys (Required for production authentication & audit logs)
# ---------------------------------------------------------------------------
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=run_generation_command_python_-c_"import_secrets;print(secrets.token_urlsafe(32))"

# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUDIT_HMAC_SECRET=run_generation_command_python_-c_"import_secrets;print(secrets.token_urlsafe(32))"

# ---------------------------------------------------------------------------
# Networking & Server Configuration
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
HEADLESS=1
NO_BROWSER_OPEN=1

# ---------------------------------------------------------------------------
# Database & Storage
# ---------------------------------------------------------------------------
DB_PATH=contextguard.db
AUDIT_ANCHOR_FILE=audit_anchor.jsonl

# ---------------------------------------------------------------------------
# Optional LLM Consistency Checker (Phase 2 & Config H)
# ---------------------------------------------------------------------------
LLM_PROVIDER=none
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=
